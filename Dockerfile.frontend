# Stage 1: Build CSS
FROM node:20-alpine AS build
WORKDIR /app
COPY package.json tailwind.config.js ./
COPY css/input.css ./css/
COPY index.html ./
COPY js/ ./js/
RUN npx tailwindcss -i ./css/input.css -o ./css/styles.css --minify

# Stage 2: Serve with nginx
FROM nginx:alpine

# Copy nginx configuration
COPY nginx.conf /etc/nginx/nginx.conf

# Copy all static frontend files
COPY index.html /usr/share/nginx/html/
COPY sw.js /usr/share/nginx/html/
COPY manifest.json /usr/share/nginx/html/

# Copy ES module files
COPY js/ /usr/share/nginx/html/js/

# Copy PWA icons
COPY icons/ /usr/share/nginx/html/icons/

# Copy built CSS from build stage
COPY --from=build /app/css/styles.css /usr/share/nginx/html/css/styles.css

# Use non-root nginx user
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chown -R nginx:nginx /var/cache/nginx && \
    chown -R nginx:nginx /var/log/nginx && \
    touch /var/run/nginx.pid && \
    chown -R nginx:nginx /var/run/nginx.pid

USER nginx

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost/ || exit 1
