# ===========================================
# FoodPlanner Docker Konfiguration
# ===========================================
# Kopiere diese Datei zu .env und passe die Werte an

# Gemini API Key (ERFORDERLICH)
# Erhalte deinen kostenlosen API Key hier: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# PostgreSQL Passwort (Optional)
# Standard: foodplanner_secret
# Empfehlung: Setze ein sicheres Passwort in Produktion!
DB_PASSWORD=foodplanner_secret

# Image Version (Optional)
# Standard: latest
# Beispiel: VERSION=1.6.0
#VERSION=latest

# JWT Secret (ERFORDERLICH in Produktion)
# Generiere einen sicheren Wert: openssl rand -hex 32
JWT_SECRET=change-this-to-a-secure-random-secret-in-production

# JWT Access-Token-Gültigkeit (Optional)
# Standard: 15m (Refresh-Token gilt 7d)
#JWT_EXPIRES_IN=15m

# CORS Origin (Optional)
# Standard: http://localhost:5173
# In Produktion auf die echte Domain setzen!
#CORS_ORIGIN=https://foodplanner.example.com

# Port (Optional)
# Standard: 5173
#PORT=5173
